      "get": {
        "summary": "Get Single Frame",
        "description": "Fetch a single frame for preview (e.g., timeline hover)",
        "operationId": "get_single_frame_api_files__lab___filename__frame__frame_number__get",
        "parameters": [
          {
            "name": "lab",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Lab"
            }
          },
          {
            "name": "filename",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Filename"
            }
          },
          {
            "name": "frame_number",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
