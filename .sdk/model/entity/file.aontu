# Entity: file

main: kit: entity: file: {

  alias: field: {}

  fields: {
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
    parts: [
      "lab"
      "filename"
    ]
    sep: "/"
  }

  name: "file"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /api/files/{lab}/{filename}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "filename"
                or: "filename"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "lab"
                or: "lab"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                ex: 1000
                k: "query"
                n: "max_frame"
                or: "max_frames"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 0
                k: "query"
                n: "start_frame"
                or: "start_frame"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/api/files/{lab}/{filename}"
          q: {
            exist: [
              "filename"
              "lab"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "files"
            }
            {
              var: "lab"
            }
            {
              var: "filename"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "GET /api/files"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/api/files"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "files"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
